# Copy to .env locally if needed. Railway injects PORT automatically.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/commerce_ops_mcp?schema=public

# Optional separate database for focused PostgreSQL tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/commerce_ops_mcp_test?schema=public

# Optional listen bind override (defaults: 127.0.0.1 locally, 0.0.0.0 on Railway/production).
# HOST=0.0.0.0

# Comma-separated Host/Origin hostnames allowed for /mcp (in addition to localhost).
# Set this to your Railway public hostname if RAILWAY_PUBLIC_DOMAIN is not enough.
# ALLOWED_HOSTS=your-app.up.railway.app

# Smoke client only (not read by the server):
# MCP_URL=http://127.0.0.1:3000/mcp
